# Credentials below must match docker-compose.yml (the canonical source) and
# .github/workflows/ci.yml.
DATABASE_URL="postgresql://us_os:us_os_dev_password@localhost:5432/us_os_dev?schema=public"

# Used by the Prisma Client at runtime instead of DATABASE_URL. Must be a
# non-superuser, NOBYPASSRLS role or Row-Level Security policies are silently
# bypassed. DATABASE_URL (the superuser bootstrap role) is reserved for
# `prisma migrate`/`generate`, which need privileges this role doesn't have.
APP_DATABASE_URL="postgresql://us_os_app:us_os_app_dev_password@localhost:5432/us_os_dev?schema=public"
